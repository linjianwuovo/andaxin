<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 骨架阶段只带网络；定位、通知、相机等等到对应批次再声明，
         声明一条就要在界面上解释一条，别提前要权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 跑步那一块要这三条：定位采轨迹、通知发实况、前台服务让屏灭着也能继续采。
         POST_PROMOTED_NOTIFICATIONS 是 Android 16 的实况更新提升，拿不到就降级普通常驻通知。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 扫码签到才用相机；不是必须，没相机也能用这个应用 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 上课提醒要排一颗精确闹钟。10-20 装机实测：不声明这条的话点开关直接
         SecurityException 闪退 —— 我原先以为 setAlarmClock 不要权限，那是对的 API 文档
         没管住这台 ROM。现在照实声明，并且排之前先问 canScheduleExactAlarms()，
         用户把权限关了也不炸，只是退化成一条可能晚几分钟的闹钟（界面上会说）。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 这条只是让重启后能自己把闹钟排回去。国产 ROM 上开机广播收不收得到，
         取决于用户给没给"自启动"，那个开关我们读不到，所以设置那一行写的是
         "重启后要打开一次 App 才稳"，不装作开机就万事大吉。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      networkSecurityConfig 只给一台服务器开明文：sports.aiit.edu.cn:8082 是 http，不是 https。
      Android 9 起系统默认禁明文，OkHttp 会直接抛
        CLEARTEXT communication to sports.aiit.edu.cn not permitted by network security policy
      界面上表现成"跑量拉不到"，看着像不在校内 —— 10-20 中午同一时刻手机上
      `toybox nc -z sports.aiit.edu.cn 8082` 回 0，端口是通的。
      不用 usesCleartextTraffic="true"：那会把整个 App 的明文都放开，包括带 token 的那批接口。
      注意这一份只管"允不允许"，OkHttp 那边还得**有**明文能力（见 core/net/Http.kt 那段）。
    -->
    <application
        android:name=".AndaXinApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"

        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.AndaXin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.run.RunService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 查寝签到拍照：相机把图写到 cache/checkin/，经 FileProvider 授权给它写 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 上课提醒那颗闹钟。exported=false：只接自己包内投的广播 -->
        <receiver
            android:name="com.andaxin.core.schedule.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.andaxin.action.CLASS_REMIND" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.andaxin.core.schedule.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
